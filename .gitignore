# ============================================
# cppgamearch - Comprehensive .gitignore
# Tech stack: macOS, C++23, SDL3, Metal-cpp, Slang, GLM
# ============================================

# ---- macOS System Files ----
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud

# ---- C++ Compiled Artifacts ----
# Object files
*.o
*.obj
*.lo
*.slo
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Static libraries
*.a
*.lib
*.la
*.lai

# Executables
*.exe
*.out
*.app
*.dSYM/

# Dependency files
*.d

# ---- CMake / Build Systems ----
# Build directories (common names)
build/
build-*/
cmake-build-*/
out/
bin/
intermediate/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json
Makefile

# ---- Xcode / Apple Development ----
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/

# ---- IDE / Editor Files ----
# Visual Studio Code
.vscode/
*.code-workspace

# ---- clangd index cache ----
.cache/

# CLion / JetBrains
.idea/
*.iml

# Visual Studio
.vs/
*.vcxproj.user
*.sdf
*.suo
*.ncb
*.opendb
*.VC.db

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ---- Slang Shader Compiler ----
# Compiled shader outputs (intermediate)
*.spv
*.dxil
*.metal
*.slang-module
*.slang-lib

# Files generated by slangc / build processes
# (Adjust if your project generates other intermediate shader files)
*.actual
*.actual.txt
*.actual.png

# ---- Metal-cpp (Header-only, but generated files) ----
# If you use the SingleHeader generator script
SingleHeader/Metal.hpp

# ---- GLM / Third-party Dependencies ----
# If vendored as submodules, typically handled by their own .gitignore.
# If vendored directly (not recommended), ignore their build artifacts:
# third_party/glm/build*/
# third_party/glm/CMakeCache.txt
# third_party/glm/CMakeFiles/

# ---- Logs & Temporary Files ----
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej